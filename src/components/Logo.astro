---
/** The logo of tTerm, drawn in place: no request, the same in both themes. */
interface Props {
	size?: number;
}
const { size = 30 } = Astro.props;
---

<svg class="tt-logo" width={size} height={size} viewBox="0 0 512 512" aria-hidden="true">
	<rect width="512" height="512" rx="116" fill="#131417"></rect>
	<path d="M118 168 L206 256 L118 344" fill="none" stroke="#E9A33F" stroke-width="56" stroke-linecap="round" stroke-linejoin="round"></path>
	<path d="M330 140 L330 316 C330 344 344 356 372 350" fill="none" stroke="#EDEFF3" stroke-width="56" stroke-linecap="round"></path>
	<path d="M272 212 L392 212" fill="none" stroke="#EDEFF3" stroke-width="56" stroke-linecap="round"></path>
</svg>

---
/**
 * A screenshot of tTerm, in the language and the theme the reader reads in.
 *
 * The pictures are taken from a tTerm Web of our own with made-up data, in
 * the language of the page and at twice their size:
 * src/assets/shots/<folder>/<name>.light.webp and .dark.webp, where <folder>
 * is the language's folder of the docs (en for English). A language without
 * a picture of its own shows the English one: a picture with no words in it
 * is kept in en alone.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** The picture's name: blocks-feed for blocks-feed.light.webp and .dark.webp. */
	name: string;
	/** What the picture shows, for whoever cannot see it. */
	alt: string;
}

const { name, alt } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*/*.webp', {
	eager: true,
});
const folder = Astro.locals.starlightRoute?.locale ?? 'en';
const find = (theme: 'light' | 'dark') =>
	(
		shots[`../assets/shots/${folder}/${name}.${theme}.webp`] ??
		shots[`../assets/shots/en/${name}.${theme}.webp`]
	)?.default;
const light = find('light');
const dark = find('dark');
if (!light || !dark) throw new Error(`No screenshot "${name}" in src/assets/shots/en/`);
// Made at 2x: shown at half their pixels, sharp on a dense screen.
const width = Math.round(light.width / 2);
---

<figure class="tt-shot">
	<a href={light.src} class="dark:sl-hidden">
		<Image src={light} alt={alt} width={width} densities={[1, 2]} />
	</a>
	<a href={dark.src} class="light:sl-hidden">
		<Image src={dark} alt={alt} width={width} densities={[1, 2]} />
	</a>
</figure>
